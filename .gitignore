__pycache__/
*.py[cod]
*.pyo

# Local data and generated artifacts
data/
batch_eval_results/
runs/
sam2_tracks/
tmp/

# Synthetic-test fixtures and diagnostics are regenerated by
# physics_eval/tests/run_synthetic_smoke.py.
physics_eval/tests/metadata_missing_json_results/
physics_eval/tests/synthetic_data/
physics_eval/tests/synthetic_diag_results/

# Third-party code and large model checkpoints
repo/
*.pt
*.pth
*.ckpt
*.safetensors

# Generated videos and masks are ignored by default. The released benchmark
# videos under video/ are explicitly re-included below and tracked with Git LFS.
*.mp4
*.mov
*.avi
*.mkv
!video/
!video/**/*.mp4
!video/**/*.mov
!video/**/*.avi
!video/**/*.mkv
video/*.zip

# LaTeX build outputs
*.aux
*.bbl
*.blg
*.fdb_latexmk
*.fls
*.log
*.out
*.synctex.gz

# OS/editor
.DS_Store
Thumbs.db
.vscode/
.idea/

